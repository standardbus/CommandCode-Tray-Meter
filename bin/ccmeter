#!/usr/bin/env node
/**
 * Command Code limits meter for Linux and macOS.
 *
 * Shares every parsing, credential and formatting rule with the Windows tray:
 * both import `src/limits.mjs`, the text comes from `src/render.mjs`, and both
 * read the same `lang/*.json` tables, so no value and no label can be computed
 * two different ways.
 *
 *   ccmeter                      current limits, human readable
 *   ccmeter --watch              redraw on the configured interval
 *   ccmeter --watch 30           redraw every 30 seconds
 *   ccmeter --compact            one line per refresh, for a status bar
 *   ccmeter --json               the raw payload as indented JSON
 *   ccmeter --profile work       only this account (repeatable)
 *   ccmeter --list-profiles      the configured accounts
 *   ccmeter --language it        en, it or zh
 *   ccmeter --auth-only          which credential source was found
 *   ccmeter --config PATH        use an alternative configuration file
 *   ccmeter --url URL            probe another host (fixture server)
 *
 * Exit codes, matching src/fetch.mjs: 0 = data or a non-fatal provider error,
 * 2 = authentication needed, 3 = the command could not run at all.
 */

import { existsSync, readFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import {
  STATUS,
  fetchAllProfiles,
  loadConfig,
  normalizeConfig,
  redact,
  resolveCredential,
  resolveProfiles,
} from "../src/limits.mjs";
import { DEFAULT_LANGUAGE, LANGUAGES, setLanguage, t, languageFallbackNotice } from "../src/i18n.mjs";
import { renderAccounts } from "../src/render.mjs";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

/** Package version for --version; a bare checkout without one is still usable. */
function version() {
  try {
    return JSON.parse(readFileSync(join(ROOT, "package.json"), "utf8")).version ?? "unknown";
  } catch {
    return "unknown";
  }
}

function parseArgs(argv) {
  const options = {
    watch: null,
    compact: false,
    json: false,
    authOnly: false,
    listProfiles: false,
    profiles: [],
    configPath: "",
    url: "",
    language: "",
    color: true,
    ascii: false,
  };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--watch") {
      const next = argv[index + 1];
      if (next !== undefined && /^\d+$/.test(next)) {
        options.watch = Number(next);
        index += 1;
      } else {
        options.watch = 0;
      }
    } else if (arg.startsWith("--watch=")) {
      const value = arg.slice("--watch=".length);
      options.watch = /^\d+$/.test(value) ? Number(value) : 0;
    } else if (arg === "--compact") options.compact = true;
    else if (arg === "--json") options.json = true;
    else if (arg === "--auth-only") options.authOnly = true;
    else if (arg === "--list-profiles") options.listProfiles = true;
    else if (arg === "--no-color") options.color = false;
    else if (arg === "--ascii") options.ascii = true;
    else if (arg === "--profile") options.profiles.push(String(argv[++index] ?? "").toLowerCase());
    else if (arg.startsWith("--profile=")) options.profiles.push(arg.slice("--profile=".length).toLowerCase());
    else if (arg === "--language") options.language = argv[++index] ?? "";
    else if (arg.startsWith("--language=")) options.language = arg.slice("--language=".length);
    else if (arg === "--config") options.configPath = argv[++index] ?? "";
    else if (arg.startsWith("--config=")) options.configPath = arg.slice("--config=".length);
    else if (arg === "--url") options.url = argv[++index] ?? "";
    else if (arg.startsWith("--url=")) options.url = arg.slice("--url=".length);
    else if (arg === "--help" || arg === "-h") options.help = true;
    else if (arg === "--version" || arg === "-V") options.version = true;
    else {
      options.unknown = arg;
    }
  }
  return options;
}

const options = parseArgs(process.argv.slice(2));

/** Usage text, assembled from the active language table. */
const usage = () =>
  [
    t("cli.tagline"),
    "",
    t("cli.usage"),
    "",
    t("cli.optDefault"),
    t("cli.optWatch"),
    t("cli.optCompact"),
    t("cli.optJson"),
    t("cli.optAuthOnly"),
    t("cli.optProfile"),
    t("cli.optList"),
    t("cli.optConfig"),
    t("cli.optUrl"),
    t("cli.optLanguage"),
    t("cli.optNoColor"),
    t("cli.optAscii"),
    t("cli.optHelp"),
    t("cli.optVersion"),
    "",
    t("cli.exitCodes"),
  ].join("\n");

// A language named on the command line wins over the configuration, because a
// one-off invocation should not require editing config.json.
if (options.language) setLanguage(options.language);

if (options.unknown !== undefined) {
  console.error(t("cli.unknownArgument", { arg: options.unknown }));
  console.error(t("cli.tryHelp"));
  process.exit(3);
}
if (options.version) {
  console.log(`ccmeter ${version()}`);
  process.exit(0);
}
if (options.help) {
  console.log(usage());
  process.exit(0);
}

// Colours only when a human is watching: a pipe, a redirect or NO_COLOR gets
// plain text, so logs and status bars never carry escape sequences.
const color = options.color && !process.env.NO_COLOR && process.stdout.isTTY === true;

function resolveConfigPath() {
  if (options.configPath) return resolve(options.configPath);
  const beside = join(ROOT, "config.json");
  return existsSync(beside) ? beside : join(process.cwd(), "config.json");
}

const configPath = resolveConfigPath();
let config;
try {
  config = loadConfig(configPath);
} catch (error) {
  console.error(redact(t("error.configUnreadable", { message: error.message })));
  process.exit(3);
}
if (options.url) {
  config = normalizeConfig({ ...config, endpoints: { ...config.endpoints, baseUrl: options.url } });
}
// Without the flag, the configuration decides; without either, English.
if (!options.language) setLanguage(config.language || DEFAULT_LANGUAGE);
const fallbackNotice = languageFallbackNotice();
if (fallbackNotice) console.error(fallbackNotice);

let profiles;
try {
  profiles = resolveProfiles(config);
} catch (error) {
  console.error(t("error.profilesInvalid", { message: error.message }));
  process.exit(3);
}

if (options.listProfiles) {
  if (profiles.length === 0) {
    console.log(t("cli.noProfiles"));
    process.exit(0);
  }
  for (const profile of profiles) {
    console.log(t("cli.profileListEntry", { id: profile.id, name: profile.name }));
  }
  process.exit(0);
}

if (options.authOnly) {
  const report = profiles.map((profile) => {
    const credential = resolveCredential(profile.config);
    return {
      id: profile.id,
      name: profile.name,
      hasToken: Boolean(credential.token),
      source: credential.source,
      ...(credential.error ? { status: credential.error } : {}),
    };
  });
  const payload = profiles.length === 1 ? { configPath, configExists: existsSync(configPath), ...report[0] } : { configPath, accounts: report };
  console.log(JSON.stringify(payload, null, 2));
  process.exit(report.every((entry) => !entry.status) ? 0 : 2);
}

if (options.profiles.length > 0) {
  const known = new Set(profiles.map((profile) => profile.id));
  const missing = options.profiles.find((id) => !known.has(id));
  if (missing) {
    console.error(t("cli.profileUnknown", { id: missing }));
    process.exit(3);
  }
}

async function probeAll() {
  return fetchAllProfiles(config, { profiles, only: options.profiles });
}

async function once() {
  const entries = await probeAll();
  if (options.json) {
    // One account keeps the historical single-object payload so existing
    // scripts keep working; several accounts become a list of entries.
    console.log(JSON.stringify(entries.length === 1 ? entries[0].result : entries.map(({ profile, result }) => ({ id: profile.id, name: profile.name, ...result })), null, 2));
  } else {
    console.log(renderAccounts(entries, config, { color, ascii: options.ascii, compact: options.compact }));
  }
  return entries;
}

const failed = (entries) => entries.some((entry) => entry.result.status === STATUS.AUTH_NEEDED);

if (options.watch === null) {
  const entries = await once();
  process.exit(failed(entries) ? 2 : 0);
}

// --watch: redraw in place on a terminal, append otherwise, so `--watch` inside
// a pipe or a CI log stays readable instead of filling it with escapes.
const intervalSeconds = Math.max(15, options.watch > 0 ? options.watch : (config.refreshSeconds ?? 120));
const redraw = color && !options.compact;
const clear = () => {
  if (redraw) process.stdout.write("\u001b[2J\u001b[H");
};

clear();
const first = await once();
if (failed(first)) process.exit(2);

const timer = setInterval(() => {
  clear();
  void once();
}, intervalSeconds * 1000);

function stop() {
  clearInterval(timer);
  if (redraw) process.stdout.write("\n");
  process.exit(0);
}
process.on("SIGINT", stop);
process.on("SIGTERM", stop);
